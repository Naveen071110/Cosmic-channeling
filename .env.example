# ==============================================================================
# Cosmic Channeling — Environment Configuration Template
# Copy this file to .env or configure in Cloudflare / Vercel dashboard.
# ==============================================================================

# Node Environment ('development' | 'production')
NODE_ENV=development
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# Backend & Cloudflare Worker Configuration
# ------------------------------------------------------------------------------

# Neon PostgreSQL Database URL (Serverless connection string)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/cosmic_channeling?sslmode=require

# JWT Secret for Cryptographic Token Signing
JWT_SECRET=your_super_secret_jwt_signing_key_min_32_characters

# Maximum concurrent requests per worker instance
MAX_CONCURRENT_REQUESTS=50

# NASA Open API Key (Get from https://api.nasa.gov)
NASA_API_KEY=DEMO_KEY

# ------------------------------------------------------------------------------
# Authentication Providers
# ------------------------------------------------------------------------------

# Firebase Auth Configuration
FIREBASE_PROJECT_ID=cosmic-channeling

# Google OAuth (Optional Server-side Flow)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://cosmic-channeling.singhnaveen360.workers.dev/api/auth/google/callback

# ------------------------------------------------------------------------------
# Frontend Public Variables (Vite client-side)
# ------------------------------------------------------------------------------

# Firebase Web App Config
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_PROJECT_ID=cosmic-channeling
VITE_FIREBASE_AUTH_DOMAIN=cosmic-channeling.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=cosmic-channeling.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# API Base URL (Leave blank to use Vercel edge rewrite proxy /api)
# VITE_API_BASE_URL=https://cosmic-channeling.singhnaveen360.workers.dev
